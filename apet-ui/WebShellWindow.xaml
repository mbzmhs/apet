<!-- 窗口底色 = 标题栏同色(BgPanel):webview 四周 6px 缩放边带透出此色,与标题栏连成一体,不再是一圈深灰 -->
<Window x:Class="APet.UI.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="/ds.ico" Title="APet" Height="900" Width="1440" MinWidth="1024" MinHeight="600"
        Background="{StaticResource BgPanel}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自实现标题栏(原生拖拽区 + 右侧窗控按钮,Web 内容铺满其余区域) -->
        <Grid Grid.Row="0" Background="{StaticResource BgPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="OnMinimizeWindow" ToolTip="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            Click="OnMaximizeWindow" ToolTip="最大化 / 还原"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                            Click="OnCloseWindow" ToolTip="关闭"/>
                </StackPanel>
                <TextBlock x:Name="AgentTitleText" Text="APet" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
        </Grid>

        <!-- Web 前端(本地 Kestrel 伺服;浏览器与客户端访问同一地址)。
             左右下三边各留 6px:WindowChrome 的调整边框在客户区内,WebView2 是独立 HWND,
             铺满会吞掉边缘鼠标消息导致窗口无法拖拽缩放;留出边框带后缩放恢复 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" Margin="6,0,6,6"/>
            <TextBlock x:Name="WebFailed" Visibility="Collapsed" Margin="24" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 外轮廓描边(WindowStyle=None 无原生边框);最大化时贴满工作区,由 OnStateChanged 隐藏 -->
        <Border x:Name="FrameBorder" Grid.Row="0" Grid.RowSpan="2" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
