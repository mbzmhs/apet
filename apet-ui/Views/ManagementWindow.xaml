<Window x:Class="APet.UI.Views.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="/ds.ico" Title="APet 管理" Height="720" Width="1080" MinWidth="1024" MinHeight="600"
        Background="{StaticResource BgBase}"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏(与 WebShellWindow 同构) -->
        <Grid Grid.Row="0" Background="{StaticResource BgPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="OnMinimizeWindow" ToolTip="最小化"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            Click="OnMaximizeWindow" ToolTip="最大化 / 还原"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                            Click="OnCloseWindow" ToolTip="关闭"/>
                </StackPanel>
                <TextBlock Text="APet 管理" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
        </Grid>

        <!-- Web 首页(Agent 增删/启停/设置入口);左右下三边留 6px 调整边框带,理由同 WebShellWindow -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" Margin="6,0,6,6"/>
            <TextBlock x:Name="WebFailed" Visibility="Collapsed" Margin="24" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 外轮廓描边(WindowStyle=None 无原生边框);最大化时贴满工作区,由 OnStateChanged 隐藏 -->
        <Border x:Name="FrameBorder" Grid.Row="0" Grid.RowSpan="2" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
