<Window x:Class="APet.UI.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/ds.ico" Title="APet" Width="384" MinHeight="170" SizeToContent="Height" MaxWidth="480"
        Background="{StaticResource BgBase}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏(可拖拽) -->
        <Grid Grid.Row="0" Background="{StaticResource BgPanel}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;"
                        Click="OnCancel" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭"/>
                <TextBlock x:Name="TitleText" Text="APet" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </DockPanel>
        </Grid>

        <!-- 消息正文 + 按钮 -->
        <StackPanel Grid.Row="1" Margin="18,16,18,18">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource FgPrimary}" LineHeight="20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" MinWidth="76" Padding="12,5"
                        IsCancel="True" Click="OnCancel"/>
                <Button Content="确定" MinWidth="76" Padding="12,5" Margin="8,0,0,0"
                        IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </StackPanel>

        <!-- 窗口外轮廓描边 -->
        <Border Grid.Row="0" Grid.RowSpan="2" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" IsHitTestVisible="False"/>
    </Grid>
</Window>
